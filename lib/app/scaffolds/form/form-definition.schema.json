{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openyida.local/schema/form-definition-v1.json",
  "title": "OpenYida native form definition",
  "type": "object",
  "required": ["version", "formTitle", "fields"],
  "properties": {
    "version": { "const": 1 },
    "formTitle": { "type": "string", "minLength": 1 },
    "appType": { "type": "string" },
    "formUuid": { "type": "string" },
    "corpId": { "type": "string" },
    "layout": { "enum": ["single", "double", "card", "section", "1", "2"] },
    "theme": { "enum": ["default", "compact", "comfortable"] },
    "labelAlign": { "enum": ["top", "left", "right"] },
    "themeTokens": {
      "type": "object",
      "propertyNames": { "pattern": "^--[A-Za-z0-9_-]+$" },
      "additionalProperties": { "type": ["string", "number"] }
    },
    "formDetailPreset": { "enum": ["clean-card", "none"] },
    "fields": {
      "type": ["array", "object"],
      "minItems": 1
    },
    "validations": { "type": "array" },
    "rules": { "type": "array" },
    "dataSources": { "type": ["array", "object"] }
  },
  "additionalProperties": true
}
