{
  "version": 1,
  "formTitle": "业务登记表",
  "layout": "single",
  "theme": "comfortable",
  "labelAlign": "top",
  "themeTokens": {
    "--color-brand1-6": "#2563eb",
    "--color-brand1-1": "#eff6ff",
    "--openyida-form-bg": "#f6f8fb",
    "--openyida-form-surface": "#ffffff",
    "--openyida-form-border": "#d8e0ea",
    "--openyida-form-text": "#172033"
  },
  "formDetailPreset": "clean-card",
  "fields": [
    {
      "type": "Divider",
      "title": "基本信息",
      "dividerType": "bold-with-thin"
    },
    {
      "key": "title",
      "type": "TextField",
      "label": "事项名称",
      "required": true,
      "placeholder": "请输入事项名称"
    },
    {
      "key": "owner",
      "type": "EmployeeField",
      "label": "负责人",
      "required": true
    },
    {
      "key": "status",
      "type": "SelectField",
      "label": "状态",
      "required": true,
      "dataSource": ["待处理", "进行中", "已完成"]
    },
    {
      "key": "dueDate",
      "type": "DateField",
      "label": "计划完成时间"
    },
    {
      "type": "Divider",
      "title": "补充说明",
      "dividerType": "bold-with-thin"
    },
    {
      "key": "description",
      "type": "TextareaField",
      "label": "说明",
      "placeholder": "请输入说明"
    }
  ],
  "validations": [
    {
      "field": "事项名称",
      "rules": [
        {
          "type": "required",
          "message": "请输入事项名称"
        }
      ]
    }
  ],
  "rules": [],
  "dataSources": []
}
