{
  "name": "openyida",
  "version": "2026.7.19",
  "description": "OpenYida CLI - 宜搭低代码 AI 开发工具（安装即用，零配置）",
  "bin": {
    "openyida": "bin/yida.js",
    "yida": "bin/yida.js"
  },
  "files": [
    "bin/",
    "lib/",
    "agent/",
    "project/config.json",
    "project/prd/demo-*.md",
    "yida-skills/",
    "!lib/samples/**/assets/**",
    "scripts/",
    "!scripts/e2e-real/",
    "!scripts/eval/",
    "docs/capabilities.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest",
    "test:unit": "jest",
    "test:e2e:real": "node scripts/e2e-real/runner.js",
    "test:e2e:real:full": "node scripts/e2e-real/full-runner.js",
    "test:e2e:real:skills": "node scripts/e2e-real/skill-coverage.js",
    "test:e2e:real:cleanup": "node scripts/e2e-real/cleanup.js",
    "eval:e2e": "node scripts/eval/runner.js --mode e2e",
    "eval:routing": "node scripts/eval/runner.js --mode routing",
    "eval:generate": "node scripts/eval/runner.js --mode generate",
    "eval:all": "node scripts/eval/runner.js --mode all",
    "eval:doc-quality": "node scripts/eval/runner.js --mode doc-quality",
    "eval:safety": "node scripts/eval/runner.js --mode safety",
    "eval:comprehensive": "node scripts/eval/runner.js --mode comprehensive",
    "eval:coverage": "node scripts/eval/runner.js --mode coverage",
    "eval:dashboard": "node scripts/eval/dashboard/server.js",
    "eval:baseline": "node scripts/eval/runner.js --mode baseline",
    "eval:pipeline": "node scripts/eval/runner.js --mode pipeline",
    "test:coverage": "jest --coverage",
    "lint": "eslint bin/ lib/ scripts/ tests/ --ext .js",
    "lint:fix": "eslint bin/ lib/ scripts/ tests/ --ext .js --fix",
    "solution:runner": "node scripts/solution-center-runner.js",
    "build:skills": "node scripts/build-skills-package.js",
    "docs:commands": "node scripts/generate-command-docs.js",
    "check:quick": "npm run check:structure && npm run check:commands && npm run check:docs && npm run check:i18n && npm run check:syntax && npm run lint",
    "check:structure": "node scripts/validate-structure.js",
    "check:commands": "node scripts/validate-command-manifest.js",
    "check:docs": "node scripts/generate-command-docs.js --check",
    "check:skills": "node scripts/validate-skills.js",
    "check:i18n": "node scripts/validate-i18n.js --check",
    "check:i18n:audit": "node scripts/validate-i18n.js",
    "check:i18n:baseline": "node scripts/validate-i18n.js --update-baseline",
    "check:syntax": "node scripts/check-syntax.js",
    "check:release-risks": "node scripts/check-release-risks.js",
    "check:package-size": "node scripts/validate-package-size.js",
    "check:package": "npm pack --dry-run",
    "check:release": "npm run check:ci",
    "check:ci": "bash scripts/validate-ci.sh",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "yida",
    "aliwork",
    "dingtalk",
    "cli",
    "openyida",
    "low-code",
    "ai",
    "qoder",
    "wukong",
    "mulerun"
  ],
  "author": "OpenYida Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openyida/openyida.git"
  },
  "bugs": {
    "url": "https://github.com/openyida/openyida/issues"
  },
  "homepage": "https://github.com/openyida/openyida#readme",
  "dependencies": {
    "@babel/standalone": "^7.15.1",
    "qrcode": "^1.5.4",
    "uglify-js": "^3.19.3"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
